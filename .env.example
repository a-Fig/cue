# Claude (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Shared secret: the page must be opened with ?token=<this> to call the API
AGENT_TOKEN=change-me

PORT=3000

# Recall.ai
RECALL_API_KEY=
RECALL_REGION=us-west-2
# Public HTTPS URL where this server is reachable (tunnel or deploy)
PUBLIC_URL=https://your-tunnel.trycloudflare.com
BOT_NAME=Cue
# The bot's machine: web_4_core (default, +$0.10/h, smooth video), web (cheapest), web_gpu
BOT_VARIANT=

# npm run cue / npm run panel
CUE_MAX_MINUTES=60
# The local panel (npm run panel) listens on 127.0.0.1 only
PANEL_PORT=3900

# System 1 (#50): Jev on OpenRouter decides whether to act before Claude decides what to show.
# On whenever the key is set; CUE_GATE=off turns it off. JEV_QUIET_AT is how sure "no" must be.
OPENROUTER_API_KEY=
CUE_GATE=
JEV_QUIET_AT=0.7
